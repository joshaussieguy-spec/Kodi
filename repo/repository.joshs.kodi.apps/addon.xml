<?xml version="1.0" encoding="UTF-8"?>
<addon
    id="repository.joshs Kodi.apps"
    version="1.0.0"
    name="Josh's Kodi Apps"
    provider-name="Josh"
>
    <requires>
        <import addon="xbmc.addon" version="16.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Josh's Kodi Apps">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/joshaussieguy-spec/Kodi/main/repo/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/joshaussieguy-spec/Kodi/main/repo/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/joshaussieguy-spec/Kodi/main/repo/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Josh's personal Kodi addons</summary>
        <description>AFL, Arabic channels, F1 streams and helpers.</description>
        <platform>all</platform>
    </extension>
</addon>